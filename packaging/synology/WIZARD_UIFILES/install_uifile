[
    {
        "step_title": "fileflinger settings",
        "items": [
            {
                "type": "textfield",
                "desc": "The URL where fileflinger is reachable from outside, e.g. https://files.example.com. Share links are built from this.",
                "subitems": [
                    {
                        "key": "wizard_base_url",
                        "desc": "Base URL",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^https?:\\/\\/[^\\s\"\\\\]+$/",
                                "errorText": "Enter a URL starting with http:// or https://"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "The port fileflinger listens on. It runs without root, so it has to be 1024 or higher. If you front it with DSM's reverse proxy, this is the proxy's destination port.",
                "subitems": [
                    {
                        "key": "wizard_port",
                        "desc": "Port",
                        "defaultValue": "6446",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^(102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$/",
                                "errorText": "Enter a port between 1024 and 65535"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "Only members of these groups (comma-separated GIDs) can share files. 101 is administrators on a stock DSM install.",
                "subitems": [
                    {
                        "key": "wizard_allowed_gids",
                        "desc": "Allowed group IDs",
                        "defaultValue": "101",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^[0-9]+( *, *[0-9]+)*$/",
                                "errorText": "Enter numeric group IDs separated by commas"
                            }
                        }
                    }
                ]
            }
        ]
    }
]
